   "source": [
    "import numpy as np\n",
    "from scipy.interpolate import CubicSpline\n",
    "\n",
    "x_nodes = np.array([1, 2, 3])\n",
    "y_nodes = np.array([2, 3, 5])\n",
    "\n",
    "spline = CubicSpline(x_nodes, y_nodes, bc_type='natural')\n",
    "x_test = 2.5\n",
    "print(f\"Interpolierter Wert bei x={x_test}: y={spline(x_test):.4f}\")"
   ]
  }
 ],
