     "text": [
      "Taylor-Polynom 3. Grades um x0=0:\n",
      "-x**3/6 + x\n"
     ]
    }
   ],
   "source": [
    "import sympy as sp\n",
    "\n",
    "x = sp.symbols('x')\n",
    "f = sp.sin(x)\n",
    "x0 = 0    # Entwicklungsstelle\n",
    "grad = 4  # Grad des Polynoms\n",
    "\n",
    "taylor = sp.series(f, x, x0=x0, n=grad).removeO()\n",
    "print(f\"Taylor-Polynom {grad-1}. Grades um x0={x0}:\")\n",
    "print(taylor)"
   ]
  }
 ],
